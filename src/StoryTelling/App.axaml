<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StoryTelling.App"
             xmlns:local="using:StoryTelling"
             xmlns:vm="using:StoryTelling.ViewModels"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <DataTemplate x:Key="ProgressItemTemplate" x:DataType="vm:ProgressItemViewModel">
            <Grid ColumnDefinitions="22,*" Margin="0,3">
                <TextBlock Text="{Binding Marker}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Header}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Stage}"
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStage}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBox">
            <Setter Property="IsUndoEnabled" Value="False" />
        </Style>
    </Application.Styles>
</Application>