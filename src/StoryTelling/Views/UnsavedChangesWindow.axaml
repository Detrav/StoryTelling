<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.UnsavedChangesWindow"
        x:DataType="vm:UnsavedChangesViewModel"
        Icon="/Assets/storytelling.ico"
        Title="{Binding Title}"
        Width="460"
        Height="220"
        MinWidth="380"
        MinHeight="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Discard" Click="OnDiscardClick" />
                <Button Content="Save" Classes="accent" Click="OnSaveClick" />
            </StackPanel>
        </Border>

        <TextBlock Margin="18"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
    </DockPanel>

</Window>
