<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.BookCompletionWindow"
        x:DataType="vm:BookCompletionViewModel"
        Title="Complete book"
        Width="760"
        Height="600"
        MinWidth="520"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                    <Button Content="Close" Classes="accent" Click="OnCloseClick" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Complete book" FontSize="18" FontWeight="SemiBold" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Text="{Binding ProgressText}"
                           VerticalAlignment="Center"
                           Opacity="0.7" />
            </Grid>

            <Border Grid.Row="2" BorderThickness="1" BorderBrush="#22000000" CornerRadius="4">
                <ListBox x:Name="OperationList" ItemsSource="{Binding Operations}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookCompletionItemViewModel">
                            <Grid ColumnDefinitions="22,*" Margin="0,3">
                                <TextBlock Text="{Binding Marker}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Header}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Stage}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasStage}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>

</Window>