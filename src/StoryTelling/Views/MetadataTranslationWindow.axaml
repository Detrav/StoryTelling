<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.MetadataTranslationWindow"
        x:DataType="vm:MetadataTranslationViewModel"
        Title="Translate book metadata"
        Width="620"
        Height="480"
        MinWidth="420"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                    <Button Content="Close" Classes="accent" Click="OnCloseClick" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Translate book metadata" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="Translates the book title, the annotation and every chapter title for each target language."
                       TextWrapping="Wrap"
                       Opacity="0.75" />

            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
                <ProgressBar Grid.Row="0" Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center" />

                <Border Grid.Row="1" BorderThickness="1" BorderBrush="#22000000" CornerRadius="4">
                    <ListBox x:Name="LanguageList"
                             ItemsSource="{Binding Languages}"
                             ItemTemplate="{StaticResource ProgressItemTemplate}" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
