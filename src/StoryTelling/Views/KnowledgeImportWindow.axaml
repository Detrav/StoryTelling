<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.KnowledgeImportWindow"
        x:DataType="vm:KnowledgeImportViewModel"
        Title="Import knowledge"
        Width="820"
        Height="760"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Apply" Classes="accent" Click="OnApplyClick" />
            </StackPanel>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Import knowledge" FontSize="18" FontWeight="SemiBold" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Brief}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="56"
                         PlaceholderText="Optional guidance, e.g. 'This is a D&amp;D campaign document'" />
                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                    <Button Content="Analyze" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />

            <ListBox Grid.Row="3" ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:KnowledgeImportItemViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Kind}" Opacity="0.6" />
                                </StackPanel>
                                <TextBlock Text="{Binding Tags}" Opacity="0.7" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Content}" Opacity="0.8" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4" Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>

</Window>
