<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoryTelling.ViewModels"
             x:Class="StoryTelling.Views.ChapterSummaryView"
             x:DataType="vm:ChapterSummaryViewModel">

    <ScrollViewer>
        <StackPanel Margin="14" Spacing="8">
            <TextBlock Text="Logline" Opacity="0.7" />
            <TextBox Text="{Binding Logline}" LostFocus="OnCommit" />

            <TextBlock Text="Recap — events, character changes, how the chapter ended" Opacity="0.7" />
            <TextBox Text="{Binding Recap}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="200"
                     LostFocus="OnCommit" />

            <Button Content="Generate with AI" Click="OnGenerateClick" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
