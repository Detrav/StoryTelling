<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ChapterSetupWindow"
        x:DataType="vm:ChapterSetupViewModel"
        Title="Chapter setup"
        Width="720"
        Height="700"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="{Binding ApplyLabel}"
                        Classes="accent"
                        Click="OnApplyClick"
                        IsEnabled="{Binding HasSelection}" />
            </StackPanel>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />

            <Grid Grid.Row="2" ColumnDefinitions="220,*">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                    <TextBlock Text="Role" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding Role}"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Your notes (optional)" Opacity="0.7" />
                    <TextBox Text="{Binding Notes}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="64"
                             PlaceholderText="What should happen, tone, constraints…" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
                <Button Content="Suggest again" Command="{Binding SuggestCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="160" Height="4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ListBox Grid.Row="4" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChapterSetupOptionViewModel">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasTitle}" />
                            <TextBlock Text="{Binding Direction}" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>

</Window>
