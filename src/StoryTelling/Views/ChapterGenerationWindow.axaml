<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ChapterGenerationWindow"
        x:DataType="vm:ChapterGenerationViewModel"
        Icon="/Assets/storytelling.ico"
        Title="Generate chapter"
        Width="480"
        Height="360"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                    <Button Content="Close" Classes="accent" Command="{Binding CloseCommand}" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.75" />
            <ProgressBar Grid.Row="2"
                         IsIndeterminate="True"
                         Height="6"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsBusy}" />
            <Border Grid.Row="3" BorderThickness="1" BorderBrush="#22000000" CornerRadius="4">
                <ListBox ItemsSource="{Binding Steps}"
                         ItemTemplate="{StaticResource ProgressItemTemplate}" />
            </Border>
            <TextBlock Grid.Row="4"
                       Text="{Binding Detail}"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasDetail}" />
        </Grid>
    </DockPanel>

</Window>
