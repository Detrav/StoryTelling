<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoryTelling.ViewModels"
             x:Class="StoryTelling.Views.ChapterSettingsView"
             x:DataType="vm:ChapterSettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="14" Spacing="8">
            <Button Content="Generate with AI"
                    Click="OnGenerateClick"
                    HorizontalAlignment="Left" />

            <TextBlock Text="Role in the story (Auto infers from the chapter position)" Opacity="0.7" />
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding Role}"
                      HorizontalAlignment="Stretch"
                      LostFocus="OnCommit" />

            <TextBlock Text="Title" Opacity="0.7" />
            <TextBox Text="{Binding Title}" LostFocus="OnCommit" />

            <Border IsVisible="{Binding HasDirectionSuggestion}"
                    Background="#332B6FBF"
                    CornerRadius="6"
                    Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="The AI suggests a new direction for this chapter (the story moved since it was planned)."
                               TextWrapping="Wrap"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DirectionSuggestion}" TextWrapping="Wrap" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply" Click="OnApplyDirectionSuggestionClick" />
                        <Button Content="Dismiss" Click="OnDismissDirectionSuggestionClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Direction — what should happen in this chapter" Opacity="0.7" />
            <TextBox Text="{Binding Direction}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     LostFocus="OnCommit" />

            <TextBlock Text="Notes / instructions" Opacity="0.7" />
            <TextBox Text="{Binding Notes}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     LostFocus="OnCommit" />

            <TextBlock Text="Translated titles (from Translate book metadata)" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding TranslatedTitles}" IsVisible="{Binding HasTranslatedTitles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TranslatedTitleViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding LanguageCode}" FontWeight="SemiBold" Width="34" />
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Status:" Opacity="0.7" />
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Created:" Opacity="0.7" />
                <TextBlock Text="{Binding Created}" Opacity="0.7" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
