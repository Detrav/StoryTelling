<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoryTelling.ViewModels"
             x:Class="StoryTelling.Views.ChapterSettingsView"
             x:DataType="vm:ChapterSettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="14" Spacing="8">
            <TextBlock Text="Title" Opacity="0.7" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Title}" LostFocus="OnCommit" />
                <Button Grid.Column="1"
                        Content="Generate with AI"
                        Tag="Title"
                        Click="OnGenerateClick"
                        Margin="8,0,0,0" />
            </Grid>

            <TextBlock Text="Direction — what should happen in this chapter" Opacity="0.7" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Direction}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="100"
                         LostFocus="OnCommit" />
                <Button Grid.Column="1"
                        Content="Generate with AI"
                        Tag="Direction"
                        Click="OnGenerateClick"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top" />
            </Grid>

            <TextBlock Text="Notes / instructions" Opacity="0.7" />
            <TextBox Text="{Binding Notes}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     LostFocus="OnCommit" />

            <TextBlock Text="Characters in this chapter" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding Participants}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterParticipationViewModel">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="Full" IsChecked="{Binding IsFull}" />
                            <CheckBox Grid.Column="2" Content="Name only" IsChecked="{Binding IsNameOnly}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Status:" Opacity="0.7" />
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
