<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoryTelling.ViewModels"
             x:Class="StoryTelling.Views.ChapterSettingsView"
             x:DataType="vm:ChapterSettingsViewModel">

    <ScrollViewer>
        <StackPanel Margin="14" Spacing="8">
            <Button Content="Generate with AI"
                    Click="OnGenerateClick"
                    HorizontalAlignment="Left" />

            <TextBlock Text="Role in the story (Auto infers from the chapter position)" Opacity="0.7" />
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding Role}"
                      HorizontalAlignment="Stretch"
                      LostFocus="OnCommit" />

            <TextBlock Text="Title" Opacity="0.7" />
            <TextBox Text="{Binding Title}" LostFocus="OnCommit" />

            <TextBlock Text="Direction — what should happen in this chapter" Opacity="0.7" />
            <TextBox Text="{Binding Direction}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     LostFocus="OnCommit" />

            <TextBlock Text="Notes / instructions" Opacity="0.7" />
            <TextBox Text="{Binding Notes}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="100"
                     LostFocus="OnCommit" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Status:" Opacity="0.7" />
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
