<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        xmlns:review="using:StoryTelling.Application.Review"
        x:Class="StoryTelling.Views.FixPreviewWindow"
        x:DataType="vm:FixPreviewViewModel"
        Title="Apply fix"
        Width="660"
        Height="560"
        MinWidth="440"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Apply" Classes="accent" Click="OnApplyClick" />
            </StackPanel>
        </Border>

        <StackPanel Margin="18" Spacing="10">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="Review the changes below, then Apply." Opacity="0.7" />
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="review:ReviewChange">
                            <Border Padding="10"
                                    Margin="0,0,0,8"
                                    CornerRadius="4"
                                    Background="#0F000000">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Before" Opacity="0.6" FontSize="11" />
                                    <TextBlock Text="{Binding OldValue}" TextWrapping="Wrap" Opacity="0.7" FontFamily="Consolas" />
                                    <TextBlock Text="After" Opacity="0.6" FontSize="11" />
                                    <TextBlock Text="{Binding NewValue}" TextWrapping="Wrap" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>

</Window>
