<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.AiWizardWindow"
        x:DataType="vm:AiWizardViewModel"
        Title="Generate with AI"
        Width="720"
        Height="700"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Apply" Classes="accent" Click="OnApplyClick" />
            </StackPanel>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Brief}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="64"
                         PlaceholderText="Describe what you want (optional)" />
                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                    <TextBlock Text="Options" Opacity="0.7" />
                    <NumericUpDown Value="{Binding OptionCount}" Minimum="1" Maximum="10" Width="140" />
                    <Button Content="More options"
                            Command="{Binding MoreOptionsCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Stop"
                            Command="{Binding StopCommand}"
                            IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />

            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Options}"
                     SelectedItem="{Binding SelectedOption}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GenerationOptionViewModel">
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4" Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />

            <StackPanel Grid.Row="5" IsVisible="{Binding AllowEdits}" Spacing="4">
                <TextBlock Text="Your edits (optional — overrides the selection)" Opacity="0.7" />
                <TextBox Text="{Binding Edits}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80" />
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>
