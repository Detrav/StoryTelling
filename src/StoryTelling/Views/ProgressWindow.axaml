<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ProgressWindow"
        x:DataType="vm:ProgressTaskViewModel"
        Title="{Binding Title}"
        Width="560"
        Height="440"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                    <Button Content="Close" Classes="accent" Click="OnCloseClick" IsVisible="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Description}"
                       TextWrapping="Wrap"
                       Opacity="0.75"
                       IsVisible="{Binding HasDescription}" />

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" IsVisible="{Binding HasProgress}">
                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           Text="{Binding ProgressText}"
                           VerticalAlignment="Center"
                           Opacity="0.7" />
            </Grid>

            <Border Grid.Row="3" BorderThickness="1" BorderBrush="#22000000" CornerRadius="4">
                <ListBox x:Name="TaskList"
                         ItemsSource="{Binding Items}"
                         ItemTemplate="{StaticResource ProgressItemTemplate}" />
            </Border>
        </Grid>
    </DockPanel>

</Window>
