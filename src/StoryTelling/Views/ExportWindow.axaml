<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ExportWindow"
        x:DataType="vm:ExportViewModel"
        Title="Export FB2"
        Width="560"
        Height="480"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Export" Classes="accent" Click="OnExportClick" IsEnabled="{Binding Selected}" />
            </StackPanel>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Export FB2" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1"
                       Text="Pick the language to export. English is the original text; translations use each chapter's translation, falling back to English when a chapter is not translated."
                       TextWrapping="Wrap"
                       Opacity="0.75" />

            <ListBox Grid.Row="2" ItemsSource="{Binding Languages}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExportLanguage">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Coverage}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{Binding MetadataCoverage}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>

</Window>
