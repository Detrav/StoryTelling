<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoryTelling.ViewModels"
             x:Class="StoryTelling.Views.WorkspaceView"
             x:DataType="vm:WorkspaceViewModel">

    <Grid ColumnDefinitions="Auto,*">

        <Border Grid.Column="0"
                Width="260"
                IsVisible="{Binding IsSidebarVisible}"
                BorderThickness="0,0,1,0"
                BorderBrush="#22000000">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="10,8">
                    <TextBlock Text="Chapters" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="+"
                            Width="30"
                            Height="26"
                            Command="{Binding AddChapterCommand}"
                            ToolTip.Tip="Add chapter" />
                </Grid>

                <ListBox x:Name="ChapterList"
                         ItemsSource="{Binding Chapters}"
                         SelectedItem="{Binding SelectedChapter}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChapterViewModel">
                            <Grid ColumnDefinitions="22,*" Background="Transparent" Margin="6,4">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Delete chapter" Click="OnDeleteChapterClick" />
                                        <Separator />
                                        <MenuItem Header="Move up" Click="OnMoveChapterUpClick" />
                                        <MenuItem Header="Move down" Click="OnMoveChapterDownClick" />
                                        <Separator />
                                        <MenuItem Header="Status">
                                            <MenuItem Header="Draft — not written"
                                                      ToggleType="Radio"
                                                      GroupName="ChapterStatus"
                                                      IsChecked="{Binding IsDraft, Mode=OneWay}"
                                                      ToolTip.Tip="Planned but not written yet — the AI will write this chapter."
                                                      Click="OnSetStatusDraftClick" />
                                            <MenuItem Header="Generated — up to date"
                                                      ToggleType="Radio"
                                                      GroupName="ChapterStatus"
                                                      IsChecked="{Binding IsGenerated, Mode=OneWay}"
                                                      ToolTip.Tip="The text is current. Use this to clear Stale after an edit to an earlier chapter once you have checked that this chapter is still fine."
                                                      Click="OnSetStatusGeneratedClick" />
                                            <MenuItem Header="Stale — needs regeneration"
                                                      ToggleType="Radio"
                                                      GroupName="ChapterStatus"
                                                      IsChecked="{Binding IsStale, Mode=OneWay}"
                                                      ToolTip.Tip="The text is out of date because an earlier chapter or the setup changed. Regenerate it, or set it to Generated if it is still fine."
                                                      Click="OnSetStatusStaleClick" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <TextBlock Text="{Binding Number}" Opacity="0.6" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontSize="11"
                                               Opacity="0.6"
                                               ToolTip.Tip="{Binding StatusHint}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="12,8"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#22000000">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedChapter.Title}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Content="▶" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Generate this chapter" />
                        <Button Content="↻" Command="{Binding RegenerateCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Regenerate this chapter" />
                        <Button Content="Finish" Command="{Binding FinishStoryCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Plan the concluding chapter" />
                        <Button Content="≡" Click="OnPlanChaptersClick" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Plan chapters with AI" />
                        <Button Content="Complete book" Click="OnCompleteBookClick" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Generate all pending work: chapters, summaries and translations" />
                        <Button Content="Aa" Click="OnTranslateMetadataClick" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Translate book metadata (title, annotation, chapter titles)" />
                        <Button Content="⇄" Command="{Binding TranslateChapterCommand}" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Translate this chapter" />
                        <Button Content="■" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" ToolTip.Tip="Stop" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1"
                        ItemsSource="{Binding SelectedChapter.Tabs}"
                        SelectedIndex="{Binding SelectedTabIndex}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChapterTabViewModel">
                        <TextBlock Text="{Binding Header}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:ChapterTabViewModel">
                        <ContentControl Content="{Binding Content}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

    </Grid>

</UserControl>
