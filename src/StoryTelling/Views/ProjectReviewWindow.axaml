<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ProjectReviewWindow"
        x:DataType="vm:ProjectReviewViewModel"
        Title="Knowledge review"
        Width="940"
        Height="780"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="TextBlock.destructive">
            <Setter Property="Foreground" Value="#B00020" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsFinished}">
                    <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding HasPrevious}" />
                    <Button Content="Skip" Command="{Binding SkipCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Close" Click="OnCloseClick" />
            </Grid>
        </Border>

        <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="Knowledge review" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProgressLabel}" Opacity="0.6" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Steps}"
                     SelectedItem="{Binding CurrentStep}"
                     IsVisible="{Binding !IsFinished}"
                     MaxHeight="76"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewStepViewModel">
                        <StackPanel Spacing="2" Width="150">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Opacity="0.6" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding !IsFinished}">
                <TextBox Text="{Binding Brief}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="48"
                         PlaceholderText="Optional focus for every check, e.g. 'check names and the timeline'" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <Button Content="Run" Command="{Binding RunStepCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Spacing="6" IsVisible="{Binding !IsFinished}">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
                <Expander Header="What this check verifies" IsVisible="{Binding ShowFindings}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding CurrentStep.Description}" TextWrapping="Wrap" Opacity="0.8" />
                        <ItemsControl ItemsSource="{Binding CurrentStep.Check.Checklist}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
                <Border IsVisible="{Binding CurrentStep.IsStale}"
                        Background="#22B00020"
                        Padding="8"
                        CornerRadius="4">
                    <TextBlock Text="The knowledge base changed since this step ran. Re-run to refresh."
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="4" ColumnDefinitions="320,12,*" IsVisible="{Binding ShowFindings}">                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Select all" Command="{Binding SelectAllFindingsCommand}" />
                            <Button Content="Clear" Command="{Binding ClearFindingSelectionCommand}" />
                        </StackPanel>
                        <Button Content="{Binding ApplySelectedLabel}"
                                Classes="accent"
                                HorizontalAlignment="Stretch"
                                Command="{Binding ApplySelectedCommand}"
                                IsEnabled="{Binding CanApplySelected}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding CurrentStep.Findings}"
                             SelectedItem="{Binding SelectedFinding}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewFindingViewModel">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Area}" Opacity="0.6" />
                                            <TextBlock Text="{Binding Status}" Opacity="0.6" IsVisible="{Binding HasStatus}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ScrollViewer Grid.Column="2" IsVisible="{Binding ShowDetail}">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SelectedFinding.Severity}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedFinding.Area}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedFinding.Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedFinding.Detail}" TextWrapping="Wrap" Opacity="0.85" />
                            <TextBlock Text="{Binding SelectedFinding.Suggestion}"
                                       TextWrapping="Wrap"
                                       Opacity="0.7"
                                       FontStyle="Italic"
                                       IsVisible="{Binding SelectedFinding.HasSuggestion}" />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*,*,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="1" Text="Entry · Field" FontSize="11" Opacity="0.6" />
                            <TextBlock Grid.Column="2" Text="Before" FontSize="11" Opacity="0.6" />
                            <TextBlock Grid.Column="3" Text="After" FontSize="11" Opacity="0.6" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SelectedFinding.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReviewEditRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*,*,*" ColumnSpacing="8" Margin="0,0,0,6">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Classes.destructive="{Binding IsDestructive}" />
                                        <TextBlock Grid.Column="2" Text="{Binding OldValue}" TextWrapping="Wrap" Opacity="0.7" FontFamily="Consolas" />
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding NewValue}"
                                                 IsVisible="{Binding IsEditable}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding NewValue}"
                                                   IsVisible="{Binding !IsEditable}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontStyle="Italic"
                                                   Opacity="0.75" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SelectedFinding.Status}" Opacity="0.6" TextWrapping="Wrap" />

                        <Button Content="{Binding SelectedFinding.FixLabel}"
                                Classes="accent"
                                HorizontalAlignment="Left"
                                Command="{Binding SelectedFinding.FixCommand}"
                                IsEnabled="{Binding SelectedFinding.CanFix}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="4" Spacing="8" IsVisible="{Binding IsFinished}">
                <TextBlock Text="All experts have reported." FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Apply the fixes you want, then run the review again to confirm that the knowledge base is consistent."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
                <Button Content="Run again" Command="{Binding RestartCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>
