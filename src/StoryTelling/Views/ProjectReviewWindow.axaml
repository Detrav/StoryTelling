<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ProjectReviewWindow"
        x:DataType="vm:ProjectReviewViewModel"
        Title="Knowledge review"
        Width="720"
        Height="700"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Button Content="Close" HorizontalAlignment="Right" Click="OnCloseClick" />
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10">
            <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Text="Knowledge review" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProgressLabel}" Opacity="0.6" />
            </StackPanel>

            <TextBox Grid.Row="1"
                     Text="{Binding Brief}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="52"
                     PlaceholderText="Optional focus for every check, e.g. 'check names and the timeline'"
                     IsVisible="{Binding !IsFinished}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsFinished}">
                <Button Content="Run" Command="{Binding RunStepCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
                <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding HasPrevious}" />
                <Button Content="Skip" Command="{Binding SkipCommand}" IsEnabled="{Binding !IsBusy}" />
                <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding !IsBusy}" Classes="accent" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="6">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
                <Border IsVisible="{Binding CurrentStep.IsStale}"
                        Background="#22B00020"
                        Padding="8"
                        CornerRadius="4">
                    <TextBlock Text="The knowledge base changed since this step ran. Re-run to refresh."
                               TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <ListBox Grid.Row="4" ItemsSource="{Binding CurrentStep.Findings}" IsVisible="{Binding ShowFindings}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewFindingViewModel">
                        <StackPanel Margin="0,4" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Area}" Opacity="0.6" />
                                <TextBlock Text="{Binding FixLabel}" IsVisible="{Binding IsFixed}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.85" />
                            <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic" IsVisible="{Binding HasSuggestion}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding FixLabel}" IsVisible="{Binding CanApplyFix}" IsEnabled="{Binding !IsFixed}" Tag="{Binding}" Click="OnFixClick" />
                                <Button Content="Create entry…" IsVisible="{Binding CanCreateEntry}" Tag="{Binding}" Click="OnCreateEntryClick" />
                                <Button Content="Fix with AI…" IsVisible="{Binding CanFixWithAi}" Tag="{Binding}" Click="OnAiFixClick" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Spacing="8" IsVisible="{Binding IsFinished}">
                <TextBlock Text="All experts have reported." FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Apply the fixes you want, then run the review again to confirm that the knowledge base is consistent."
                           TextWrapping="Wrap"
                           Opacity="0.75" />
                <Button Content="Run again" Command="{Binding RestartCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>
