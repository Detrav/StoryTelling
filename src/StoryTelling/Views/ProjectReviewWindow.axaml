<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ProjectReviewWindow"
        x:DataType="vm:ProjectReviewViewModel"
        Title="Settings review"
        Width="720"
        Height="700"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <Button Content="Close" HorizontalAlignment="Right" Click="OnCloseClick" />
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Settings review" FontSize="18" FontWeight="SemiBold" />

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Brief}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="56"
                         PlaceholderText="Optional focus, e.g. 'check the timeline and names'" />
                <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                    <Button Content="Run review" Command="{Binding RunCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />

            <ListBox Grid.Row="3" ItemsSource="{Binding Findings}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewFindingViewModel">
                        <StackPanel Margin="0,4" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Area}" Opacity="0.6" />
                                <TextBlock Text="{Binding FixLabel}" IsVisible="{Binding IsFixed}" Opacity="0.6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Opacity="0.85" />
                            <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Opacity="0.7" FontStyle="Italic" IsVisible="{Binding HasSuggestion}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding FixLabel}" IsVisible="{Binding CanApplyFix}" IsEnabled="{Binding !IsFixed}" Tag="{Binding}" Click="OnFixClick" />
                                <Button Content="Fix with AI…" IsVisible="{Binding CanFixWithAi}" Tag="{Binding}" Click="OnAiFixClick" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4" Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>

</Window>
