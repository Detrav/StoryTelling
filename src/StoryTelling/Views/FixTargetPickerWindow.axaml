<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.FixTargetPickerWindow"
        x:DataType="vm:FixTargetPickerViewModel"
        Title="Fix with AI"
        Width="480"
        Height="520"
        MinWidth="360"
        MinHeight="320"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Continue" Classes="accent" Click="OnContinueClick" IsEnabled="{Binding HasSelection}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="18" Spacing="10">
            <TextBlock Text="Choose what the AI should fix." TextWrapping="Wrap" Opacity="0.7" />
            <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewFixTarget">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </DockPanel>

</Window>
