<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.CharacterWindow"
        x:DataType="vm:CharacterEditorViewModel"
        Title="Character"
        Width="620"
        Height="720"
        MinWidth="460"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="OK" Classes="accent" Click="OnOkClick" IsEnabled="{Binding HasName}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="18" Spacing="6">
                <Button Content="Generate with AI"
                        Click="OnGenerateClick"
                        HorizontalAlignment="Right" />

                <TextBlock Text="Name" Opacity="0.7" />
                <TextBox Text="{Binding Name}" />

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                        <TextBlock Text="Role" Opacity="0.7" />
                        <TextBox Text="{Binding Role}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                        <TextBlock Text="Age" Opacity="0.7" />
                        <TextBox Text="{Binding Age}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Description" Opacity="0.7" />
                <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />

                <TextBlock Text="Personality" Opacity="0.7" />
                <TextBox Text="{Binding Personality}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" />

                <TextBlock Text="Background" Opacity="0.7" />
                <TextBox Text="{Binding Background}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" />

                <TextBlock Text="Goals" Opacity="0.7" />
                <TextBox Text="{Binding Goals}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />

                <TextBlock Text="Traits (comma separated)" Opacity="0.7" />
                <TextBox Text="{Binding Traits}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
