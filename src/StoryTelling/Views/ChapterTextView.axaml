<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StoryTelling.ViewModels"
             x:Class="StoryTelling.Views.ChapterTextView"
             x:DataType="vm:ChapterTextViewModel">

    <Grid RowDefinitions="Auto,*" Margin="10">
        <Button Grid.Row="0"
                Content="Translate with AI"
                IsVisible="{Binding IsTranslation}"
                Command="{Binding TranslateCommand}"
                HorizontalAlignment="Left"
                Margin="0,0,0,8" />
        <TextBox Grid.Row="1"
                 Text="{Binding Text}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top" />
    </Grid>

</UserControl>
