<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        x:Class="StoryTelling.Views.ChapterPlanWindow"
        x:DataType="vm:ChapterPlanViewModel"
        Title="Plan chapters"
        Width="820"
        Height="760"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Apply" Classes="accent" Click="OnApplyClick" IsEnabled="{Binding HasPlan}" />
            </StackPanel>
        </Border>

        <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Plan chapters" FontSize="18" FontWeight="SemiBold" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Chapters" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="{Binding MaximumCount}" Width="140" />
                </StackPanel>
                <TextBox Grid.Column="1"
                         Text="{Binding Brief}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="56"
                         Margin="12,0"
                         PlaceholderText="Optional guidance, e.g. 'slow-burn mystery with a bleak ending'" />
                <StackPanel Grid.Column="2" Spacing="4">
                    <Button Content="Generate" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="2" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />

            <ListBox Grid.Row="3" ItemsSource="{Binding Chapters}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChapterPlanItemViewModel">
                        <StackPanel Margin="0,4" Spacing="4">
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Direction}" TextWrapping="Wrap" Opacity="0.85" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="4" Text="{Binding Status}" Opacity="0.7" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>

</Window>
