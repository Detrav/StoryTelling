<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StoryTelling.ViewModels"
        xmlns:settings="using:StoryTelling.Application.Settings"
        x:Class="StoryTelling.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Settings"
        Width="720"
        Height="640"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Padding="14"
                BorderThickness="0,1,0,0"
                BorderBrush="#22000000">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="OnCancelClick" />
                <Button Content="Apply" Classes="accent" Click="OnApplyClick" />
            </StackPanel>
        </Border>

        <TabControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Provider">
                <StackPanel Margin="18" Spacing="10">
                    <TextBlock Text="Provider" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding Provider}"
                              HorizontalAlignment="Stretch"
                              LostFocus="OnCommit" />

                    <TextBlock Text="Base URL" Opacity="0.7" />
                    <TextBox Text="{Binding BaseUrl}" LostFocus="OnCommit" />

                    <TextBlock Text="Model" Opacity="0.7" />
                    <TextBox Text="{Binding Model}" LostFocus="OnCommit" />

                    <TextBlock Text="API key" Opacity="0.7" />
                    <TextBox Text="{Binding ApiKey}" PasswordChar="•" LostFocus="OnCommit" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Parameters">
                <StackPanel Margin="18" Spacing="12">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Timeout (s)" Opacity="0.7" />
                            <NumericUpDown Value="{Binding TimeoutSeconds}" Minimum="1" Maximum="600" LostFocus="OnCommit" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="Max tokens" Opacity="0.7" />
                            <NumericUpDown Value="{Binding MaxTokens}" Minimum="1" Maximum="131072" LostFocus="OnCommit" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Temperature" Opacity="0.7" />
                            <NumericUpDown Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.1" LostFocus="OnCommit" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="6,0,0,0">
                            <TextBlock Text="Max tool calls" Opacity="0.7" />
                            <NumericUpDown Value="{Binding MaxToolCalls}" Minimum="0" Maximum="100" LostFocus="OnCommit" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Roles">
                <StackPanel Margin="18" Spacing="12">
                    <TextBlock Text="Temperature per task. Lower is more deterministic; raise it for creative work. Prefer values above 0.1."
                               Opacity="0.7"
                               TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding RoleTemperatures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RoleTemperatureViewModel">
                                <Grid ColumnDefinitions="*,170,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="1"
                                                   Value="{Binding Value}"
                                                   Minimum="0"
                                                   Maximum="2"
                                                   Increment="0.1"
                                                   LostFocus="OnCommit" />
                                    <TextBlock Grid.Column="2"
                                               Text="Value too low"
                                               Foreground="#B00020"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsLow}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <TabItem Header="Context">
                <StackPanel Margin="18" Spacing="12">
                    <TextBlock Text="How much of the project is sent to the model when a chapter is written. Larger budgets add continuity but cost more tokens and can dilute focus."
                               Opacity="0.7"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Context token budget" Opacity="0.7" />
                            <NumericUpDown Value="{Binding ContextTokenBudget}" Minimum="200" Maximum="65536" Increment="500" LostFocus="OnCommit" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0">
                            <TextBlock Text="Recent loglines" Opacity="0.7" />
                            <NumericUpDown Value="{Binding RecentLoglineCount}" Minimum="0" Maximum="20" LostFocus="OnCommit" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="Required section cap (chars)" Opacity="0.7" />
                            <NumericUpDown Value="{Binding ContextRequiredSectionMaxChars}" Minimum="500" Maximum="100000" Increment="500" LostFocus="OnCommit" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Tool result budget (chars)" Opacity="0.7" />
                            <NumericUpDown Value="{Binding ToolResultMaxChars}" Minimum="1000" Maximum="200000" Increment="1000" LostFocus="OnCommit" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Languages">
                <Grid Margin="18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0"
                               Text="The selected row is the default language for new projects."
                               Opacity="0.7"
                               TextWrapping="Wrap" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Languages}"
                             SelectedItem="{Binding SelectedDefault}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="settings:LanguageData">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Remove"
                                            Tag="{Binding}"
                                            Click="OnRemoveLanguageClick" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding NewLanguageCode}" PlaceholderText="Code (e.g. it)" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding NewLanguageName}" PlaceholderText="Name" Margin="0,0,6,0" />
                        <Button Grid.Column="2" Content="Add" Command="{Binding AddLanguageCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="Languages are stored globally and offered in each project's setup."
                               Opacity="0.6"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>
